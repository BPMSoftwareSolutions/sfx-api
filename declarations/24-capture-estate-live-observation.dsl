capability capture-estate-live-observation
intent: Capture the estate's live observation channel from inside the estate for a bounded time, as an acceptance capability: one GET /events on the API with a bound (whole seconds) and the observer's optional since, run and graphId, signed in with the session credential the host vault holds under the given reference and exchanged through http-exchange, which releases it inside the graph. The answer is every record the stream carried before its bound ended, in order, with how many came in the replay before : replay-complete and how many arrived live.
outcome: estate-live-observation-capture.v1 with the HTTP status, the records in order (each the observer record), the number replayed and the number live; a refused selector or session is the HTTP status and body the API answered
inquiry: What did the estate's live observation channel carry during this bounded subscription?
input contract capture-estate-live-observation-request.v1 {"type":"object","required":["bound"],"properties":{"bound":{"type":"integer","minimum":1,"maximum":120},"since":{"type":"string"},"run":{"type":"string"},"graphId":{"type":"string"},"endpoint":{"type":"string"},"credentialReference":{"type":"string"}}}
output contract estate-live-observation-capture.v1 {"type":"object","required":["contractId","httpStatus","records"]}
cli display outcome as json
scenario capture-estate-live-observation root terminal
given: a bound in seconds, the observer's optional selectors, and the vault reference of a signed-in session
when: the channel is read for the bound through http-exchange
then: the outcome is the records the stream carried before its bound ended, in order, with the replayed and live counts
operation capture-estate-live-observation.request kind invoke-port port capture-estate-live-observation-request
operation capture-estate-live-observation.exchange kind invoke-port port capture-estate-live-observation-exchange
operation capture-estate-live-observation.records kind invoke-port port capture-estate-live-observation-records
platform bind capture-estate-live-observation-request
platform: sda-authority-transformation-port.v1
config: {"expression":{"op":"object","fields":{"executionTarget":{"op":"literal","value":"http-exchange"},"executionNamespace":{"op":"literal","value":"sidefx:capabilities"},"executionScenario":{"op":"literal","value":"http-exchange"},"inputType":{"op":"literal","value":"json"},"dispatchRequest":{"op":"object","fields":{"method":{"op":"literal","value":"GET"},"url":{"op":"format","template":"{e}/events?bound={b}{s}{r}{g}","values":{"e":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"endpoint"}},"right":{"op":"literal","value":"string"}},"then":{"op":"path","path":"endpoint"},"else":{"op":"literal","value":"https://sfx-api-test.azurewebsites.net"}},"b":{"op":"path","path":"bound"},"s":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"since"}},"right":{"op":"literal","value":"string"}},"then":{"op":"format","template":"&since={v}","values":{"v":{"op":"path","path":"since"}}},"else":{"op":"literal","value":""}},"r":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"run"}},"right":{"op":"literal","value":"string"}},"then":{"op":"format","template":"&run={v}","values":{"v":{"op":"path","path":"run"}}},"else":{"op":"literal","value":""}},"g":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"graphId"}},"right":{"op":"literal","value":"string"}},"then":{"op":"format","template":"&graphId={v}","values":{"v":{"op":"path","path":"graphId"}}},"else":{"op":"literal","value":""}}}},"credentialReference":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"credentialReference"}},"right":{"op":"literal","value":"string"}},"then":{"op":"path","path":"credentialReference"},"else":{"op":"literal","value":"SFX_API_ACCEPTANCE_SESSION"}},"credentialHeader":{"op":"literal","value":"Authorization"},"credentialPrefix":{"op":"literal","value":"Bearer "},"accept":{"op":"literal","value":"text/event-stream"}}}}}}
platform bind capture-estate-live-observation-exchange
platform: generic-capability-invocation.v1
config: {"providerId":"generic-capability-invocation","authoritySource":"DATABASE","capabilityIdPath":"executionTarget","namespacePath":"executionNamespace","scenarioPath":"executionScenario","requestPath":"dispatchRequest","resultPath":"result","lineageMode":"retain-nested-execution"}
platform bind capture-estate-live-observation-records
platform: sda-embodiment-plan-port.v1
config: {"statement":"SET NOCOUNT ON; DECLARE @status nvarchar(40),@http int,@body nvarchar(max); SELECT @status=j.status,@http=j.httpStatus,@body=j.responseBodyText FROM OPENJSON(@input,'$.result') WITH(status nvarchar(40) '$.status',httpStatus int '$.httpStatus',responseBodyText nvarchar(max) '$.responseBodyText') j; DECLARE @lines TABLE(ordinal bigint PRIMARY KEY,line nvarchar(max)); INSERT @lines SELECT s.ordinal,s.value FROM STRING_SPLIT(REPLACE(COALESCE(@body,N''),NCHAR(13),N''),NCHAR(10),1) s; DECLARE @complete bigint=(SELECT MIN(ordinal) FROM @lines WHERE line=N': replay-complete'); DECLARE @records TABLE(ordinal bigint PRIMARY KEY,record nvarchar(max)); INSERT @records SELECT ordinal,SUBSTRING(line,7,LEN(line)) FROM @lines WHERE line LIKE N'data: %' AND ISJSON(SUBSTRING(line,7,LEN(line)))=1; SELECT (SELECT N'estate-live-observation-capture.v1' AS contractId,@status AS status,@http AS httpStatus,JSON_QUERY(N'['+COALESCE((SELECT STRING_AGG(CONVERT(nvarchar(max),record),N',') WITHIN GROUP (ORDER BY ordinal) FROM @records),N'')+N']') AS records,(SELECT COUNT(*) FROM @records WHERE @complete IS NOT NULL AND ordinal<@complete) AS replayed,(SELECT COUNT(*) FROM @records WHERE @complete IS NULL OR ordinal>@complete) AS live,CASE WHEN @http=200 THEN NULL ELSE LEFT(@body,2000) END AS refusal FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;","resultColumn":"value","providerId":"sda-declared-read-graph-provider.v1"}
