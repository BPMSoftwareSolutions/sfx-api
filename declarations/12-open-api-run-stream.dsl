capability open-api-run-stream
intent: Open the live event stream of a run through the declared API: the run store confirms the run belongs to the caller and reads the caller session, and the answer instructs the hosting facade to stream the run's events as server-sent events from the given cursor until it ends, or until the session expires or a recheck through check-api-session, at the given interval, cannot confirm it. A run the caller does not own reads NOT_FOUND.
outcome: a host directive (application/vnd.sfx.host-directive+json) stream-run with the run id, cursor and stored state, or NOT_FOUND
inquiry: May this caller follow this run, and from where?
input contract open-api-run-stream-request.v1 {"type":"object"}
output contract open-api-run-stream-result.v1 {"type":"object"}
cli display outcome as json
scenario open-api-run-stream root terminal
given: the caller principal, a run id and an optional cursor
when: the run store reads the run for the caller
then: the outcome is the stream directive, or NOT_FOUND
operation open-api-run-stream.read-prepare kind invoke-port port open-api-run-stream-read-prepare
operation open-api-run-stream.read kind invoke-port port open-api-run-stream-read
operation open-api-run-stream.answer kind invoke-port port open-api-run-stream-answer
platform bind open-api-run-stream-read-prepare
platform: sda-authority-transformation-port.v1
config: {"expression":{"op":"object","fields":{"executionTarget":{"op":"literal","value":"sql-database-reader"},"executionNamespace":{"op":"literal","value":"sidefx:capabilities"},"executionScenario":{"op":"literal","value":"sql-database-reader"},"inputType":{"op":"literal","value":"json"},"dispatchRequest":{"op":"object","fields":{"dataSource":{"op":"literal","value":"sfx-identity-database"},"statement":{"op":"literal","value":"SET NOCOUNT ON; DECLARE @principal_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.principalId')); DECLARE @run_id varchar(128) = JSON_VALUE(@input, '$.runId'); DECLARE @session_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.sessionId')); DECLARE @expires datetimeoffset(7) = (SELECT s.expires_at FROM [identity].session s JOIN [identity].principal p ON p.principal_id = s.principal_id WHERE s.session_id = @session_id AND s.principal_id = @principal_id AND s.revoked_at IS NULL AND s.expires_at > SYSUTCDATETIME() AND p.active = 1); DECLARE @r TABLE(run_id varchar(128), capability_id nvarchar(512), namespace_id nvarchar(256), admitted_at datetime2(7), session_id uniqueidentifier, run_json nvarchar(max), graph_json nvarchar(max), output_json nvarchar(max), latest_cursor bigint, trace_complete bit, material_digest varbinary(32), graphs_json nvarchar(max), capture_status varchar(16)); IF @principal_id IS NOT NULL AND @run_id IS NOT NULL INSERT @r EXEC evidence.read_run @principal_id = @principal_id, @run_id = @run_id; SELECT (SELECT CASE WHEN EXISTS (SELECT 1 FROM @r) THEN 'READ' ELSE 'NOT_FOUND' END AS status, @run_id AS runId, (SELECT TOP (1) COALESCE(JSON_VALUE(run_json, '$.state'), 'admitted') FROM @r) AS state, TRY_CONVERT(bigint, JSON_VALUE(@input, '$.after')) AS after, LOWER(CONVERT(varchar(36), @principal_id)) AS principalId, LOWER(CONVERT(varchar(36), @session_id)) AS sessionId, @expires AS sessionExpiresAt, CONVERT(bit, CASE WHEN @expires IS NULL THEN 0 ELSE 1 END) AS sessionLive, COALESCE(TRY_CONVERT(int, JSON_VALUE(@input, '$.recheckMilliseconds')), 5000) AS recheckMilliseconds FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES) AS value;"},"resultColumn":{"op":"literal","value":"value"},"input":{"op":"path","path":""}}}}}}
platform bind open-api-run-stream-read
platform: generic-capability-invocation.v1
config: {"providerId":"generic-capability-invocation","authoritySource":"DATABASE","capabilityIdPath":"executionTarget","namespacePath":"executionNamespace","scenarioPath":"executionScenario","requestPath":"dispatchRequest","resultPath":"result","lineageMode":"retain-nested-execution"}
platform bind open-api-run-stream-answer
platform: sda-authority-transformation-port.v1
config: {"expression":{"op":"let","bindings":{"found":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"result.value"}},"right":{"op":"literal","value":"string"}},"then":{"op":"let","bindings":{"parsed":{"op":"try-parse-json","value":{"op":"path","path":"result.value"},"stripBom":true}},"value":{"op":"path","path":"value","from":"parsed"}},"else":{"op":"if","when":{"op":"equals","left":{"op":"type","value":{"op":"path","path":"result.value"}},"right":{"op":"literal","value":"object"}},"then":{"op":"path","path":"result.value"},"else":{"op":"path","path":"result"}}}},"value":{"op":"if","when":{"op":"equals","left":{"op":"path","path":"status","from":"found"},"right":{"op":"literal","value":"READ"}},"then":{"op":"if","when":{"op":"path","path":"sessionLive","from":"found"},"then":{"op":"object","fields":{"contractId":{"op":"literal","value":"api-response.v1"},"disposition":{"op":"literal","value":"RESPONDED"},"status":{"op":"literal","value":200},"headers":{"op":"literal","value":{"content-type":"application/vnd.sfx.host-directive+json"}},"body":{"op":"object","fields":{"directive":{"op":"literal","value":"stream-run"},"runId":{"op":"path","path":"runId","from":"found"},"after":{"op":"path","path":"after","from":"found"},"state":{"op":"path","path":"state","from":"found"},"session":{"op":"object","fields":{"expiresAt":{"op":"path","path":"sessionExpiresAt","from":"found"},"recheck":{"op":"object","fields":{"capabilityId":{"op":"literal","value":"check-api-session"},"input":{"op":"object","fields":{"principalId":{"op":"path","path":"principalId","from":"found"},"sessionId":{"op":"path","path":"sessionId","from":"found"}}},"intervalMilliseconds":{"op":"path","path":"recheckMilliseconds","from":"found"}}}}},"respond":{"op":"object","fields":{"status":{"op":"literal","value":200},"contentType":{"op":"literal","value":"text/event-stream; charset=utf-8"}}}}}}},"else":{"op":"object","fields":{"code":{"op":"literal","value":"CELL_EXECUTION_FAILED"},"message":{"op":"literal","value":"EVIDENCE_SESSION_REQUIRED"}}}},"else":{"op":"if","when":{"op":"equals","left":{"op":"path","path":"status","from":"found"},"right":{"op":"literal","value":"NOT_FOUND"}},"then":{"op":"object","fields":{"status":{"op":"literal","value":"NOT_FOUND"},"runId":{"op":"path","path":"runId","from":"found"}}},"else":{"op":"path","path":"","from":"found"}}}}}
