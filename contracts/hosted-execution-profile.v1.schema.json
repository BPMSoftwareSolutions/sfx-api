{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosted-execution-profile.v1.schema.json",
  "title": "Hosted execution profile",
  "description": "What a host deployment promises to the capabilities it executes. A consumer requirement names a profile by profileId and profileVersion and checks it by profileDigest, the SHA-256 of the profile document's exact bytes. A change to any promise is a new profileVersion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "profileId",
    "profileVersion",
    "host",
    "runtime",
    "providers",
    "childProcesses",
    "executionPaths",
    "results",
    "consumerObligations",
    "acceptance"
  ],
  "properties": {
    "contractId": {
      "const": "hosted-execution-profile.v1"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 5
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "endpoint"
      ],
      "properties": {
        "deployment": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "runtime": {
      "description": "H1. Every run this deployment executes runs in this language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promiseId",
        "language",
        "kernel"
      ],
      "properties": {
        "promiseId": {
          "const": "H1"
        },
        "language": {
          "enum": [
            "csharp",
            "python",
            "node"
          ]
        },
        "kernel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "sdaRevision",
            "rid"
          ],
          "properties": {
            "implementation": {
              "const": "sda-scenario-kernel"
            },
            "sdaRevision": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "rid": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "providers": {
      "description": "H2. A provider in a run's closure with no entry for runtime.language fails the run with this refusal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promiseId",
        "selection",
        "refusal"
      ],
      "properties": {
        "promiseId": {
          "const": "H2"
        },
        "selection": {
          "const": "entry-for-runtime-language"
        },
        "refusal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "names"
          ],
          "properties": {
            "code": {
              "const": "PROVIDER_LANGUAGE_UNAVAILABLE"
            },
            "names": {
              "type": "array",
              "items": {
                "enum": [
                  "providerProfileId",
                  "declaredLanguage",
                  "runtimeLanguage"
                ]
              },
              "minItems": 3,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "childProcesses": {
      "description": "H3. A provider program in runtime.language may start these executables, and they work under these conditions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promiseId",
        "identity",
        "environment",
        "temporaryStorage",
        "executables"
      ],
      "properties": {
        "promiseId": {
          "const": "H3"
        },
        "identity": {
          "description": "The operating-system user every kernel and child runs as.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user",
            "uid"
          ],
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "environment": {
          "description": "The executables work when the provider program clears the child's environment.",
          "const": "works-when-cleared"
        },
        "temporaryStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "operations",
            "freeBytesAtAcceptance"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "operations": {
              "type": "array",
              "items": {
                "enum": [
                  "create",
                  "write",
                  "read",
                  "delete"
                ]
              },
              "minItems": 4,
              "uniqueItems": true
            },
            "freeBytesAtAcceptance": {
              "description": "Free space measured when acceptance runs. It is not reserved: concurrent runs share it, and a later invocation can find less (consumer obligation C4).",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "lifetime"
              ],
              "properties": {
                "minimum": {
                  "type": "integer",
                  "minimum": 0
                },
                "lifetime": {
                  "const": "measured-at-acceptance-not-reserved"
                }
              }
            }
          }
        },
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/cpython"
              },
              {
                "$ref": "#/$defs/gnuTimeout"
              }
            ]
          }
        }
      }
    },
    "executionPaths": {
      "description": "H5. The bounds of each path a capability can execute on, in milliseconds, and the runs a worker path holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promiseId",
        "request",
        "worker"
      ],
      "properties": {
        "promiseId": {
          "const": "H5"
        },
        "request": {
          "$ref": "#/$defs/requestPath"
        },
        "worker": {
          "$ref": "#/$defs/workerPath"
        }
      }
    },
    "results": {
      "description": "H4. What the host preserves of a capability's answer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promiseId",
        "preservation",
        "artifactBytes",
        "maximumResultBytes"
      ],
      "properties": {
        "promiseId": {
          "const": "H4"
        },
        "preservation": {
          "description": "The declared result value reaches the caller through the API envelope unchanged.",
          "const": "declared-result-value"
        },
        "artifactBytes": {
          "description": "Artifact content is preserved as exact UTF-8 bytes, checked by SHA-256.",
          "const": "utf-8-sha256"
        },
        "maximumResultBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "consumerObligations": {
      "description": "What a consumer must meet for these promises to apply to its capabilities.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligationId",
          "statement"
        ],
        "properties": {
          "obligationId": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance": {
      "description": "The checks that establish this profile on a deployment, and when they must run again. Every promise above is covered by at least one check.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptContract",
        "coordinator",
        "repeatWhenChanged",
        "checks",
        "invocation"
      ],
      "properties": {
        "receiptContract": {
          "const": "hosted-execution-acceptance.v1"
        },
        "coordinator": {
          "description": "The host's declared request entry coordinates worker probes through its deployed HTTPS API. It never holds a worker slot while waiting for them.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilityId",
            "executionPath",
            "method",
            "path",
            "workerSlotsHeld",
            "probeTransport",
            "admittedCallers",
            "probeAuthority",
            "requestKernelsRequired",
            "budgetMs",
            "probeCompletion"
          ],
          "properties": {
            "capabilityId": {
              "const": "accept-hosted-execution-profile"
            },
            "executionPath": {
              "const": "request"
            },
            "method": {
              "const": "POST"
            },
            "path": {
              "const": "/sfx/v1/hosted-execution/acceptance"
            },
            "workerSlotsHeld": {
              "const": 0
            },
            "probeTransport": {
              "const": "deployed-https-api"
            },
            "admittedCallers": {
              "description": "Only the existing host operator principal named by this trusted profile binding may initiate acceptance. The stored probe principal is a separate identity. Request-body identity assertions never grant authority.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "principalRef",
                  "principalId",
                  "match"
                ],
                "properties": {
                  "kind": {
                    "const": "user"
                  },
                  "principalRef": {
                    "const": "host-acceptance-operator"
                  },
                  "principalId": {
                    "const": "565de6d4-ebcd-408b-9359-04d21dc62183"
                  },
                  "match": {
                    "const": "resolved-principal-id"
                  }
                }
              },
              "minItems": 1,
              "maxItems": 1
            },
            "probeAuthority": {
              "description": "The coordinator reuses the authenticated operator request session for this invocation only. It is held in request-kernel memory outside graph values, checked through the deployed HTTPS session endpoint, and never stored, returned, signed in or revoked. No separate acceptance credential is provisioned.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caller",
                "principalRef",
                "authentication",
                "credential",
                "provisioning",
                "sessionCheckPath",
                "release",
                "runVisibility",
                "sessionUse",
                "principalId"
              ],
              "properties": {
                "caller": {
                  "const": "user"
                },
                "principalRef": {
                  "const": "host-acceptance-operator"
                },
                "authentication": {
                  "const": "existing-operator-session"
                },
                "credential": {
                  "const": "invoking-request-session"
                },
                "provisioning": {
                  "const": "existing-cli-login"
                },
                "sessionCheckPath": {
                  "const": "/sfx/v1/session"
                },
                "runVisibility": {
                  "const": "own-runs"
                },
                "sessionUse": {
                  "const": "single-acceptance-invocation"
                },
                "release": {
                  "const": "request-scoped-memory"
                },
                "principalId": {
                  "const": "565de6d4-ebcd-408b-9359-04d21dc62183"
                }
              }
            },
            "requestKernelsRequired": {
              "description": "The coordinator holds one request kernel while its own API calls need another, so the request path needs at least this many kernels.",
              "type": "integer",
              "minimum": 2
            },
            "budgetMs": {
              "description": "The coordinator stops measuring by this time and issues its receipt, leaving margin within the request path's delivery bound. A check it could not finish is FAILED as an execution error.",
              "type": "integer",
              "minimum": 1
            },
            "probeCompletion": {
              "description": "The coordinator waits for a probe by reading that run's event stream through the deployed API until the stream's end frame.",
              "const": "run-event-stream-to-end"
            }
          }
        },
        "repeatWhenChanged": {
          "type": "array",
          "items": {
            "enum": [
              "imageDigest",
              "bundleDigest",
              "kernelArtifactDigest",
              "hostFilesDigest",
              "profileDigest"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkId",
              "promiseIds",
              "executionPath",
              "evidence",
              "establishes"
            ],
            "properties": {
              "checkId": {
                "type": "string",
                "pattern": "^T[0-9]+$"
              },
              "promiseIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^H[0-9]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "executionPath": {
                "description": "The path of the probe being tested, distinct from the coordinator's request path.",
                "enum": [
                  "request",
                  "worker"
                ]
              },
              "evidence": {
                "description": "execution: the check runs the behavior and measures it. configuration: the check compares the deployed settings with the profile, and proves no behavior.",
                "enum": [
                  "execution",
                  "configuration"
                ]
              },
              "establishes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "client",
            "discovery",
            "dispatch",
            "credentials",
            "failureContract",
            "uncertainOutcome",
            "completion",
            "readback"
          ],
          "properties": {
            "owner": {
              "const": "host"
            },
            "client": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "product",
                "surface",
                "capabilityId",
                "input",
                "json",
                "authentication",
                "publicationOwner",
                "exitCodes"
              ],
              "properties": {
                "product": {
                  "const": "sfx-api"
                },
                "surface": {
                  "const": "capability observe"
                },
                "capabilityId": {
                  "const": "accept-hosted-execution-profile"
                },
                "input": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                },
                "json": {
                  "const": true
                },
                "authentication": {
                  "const": "existing-operator-session"
                },
                "publicationOwner": {
                  "const": "host"
                },
                "exitCodes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accepted",
                    "rejectedReceipt",
                    "failed",
                    "unknown"
                  ],
                  "properties": {
                    "accepted": {
                      "const": 0
                    },
                    "rejectedReceipt": {
                      "const": 2
                    },
                    "failed": {
                      "const": 1
                    },
                    "unknown": {
                      "const": 3
                    }
                  }
                }
              }
            },
            "discovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capabilityId",
                "verify",
                "routing",
                "unsupported",
                "clientWaitMs",
                "endpointBinding"
              ],
              "properties": {
                "capabilityId": {
                  "const": "read-hosted-execution-profile"
                },
                "verify": {
                  "const": "exact-profile-text-sha256-and-supported-schema"
                },
                "routing": {
                  "const": "profile-acceptance-coordinator"
                },
                "unsupported": {
                  "const": "refuse-before-dispatch"
                },
                "clientWaitMs": {
                  "const": 230000
                },
                "endpointBinding": {
                  "const": "authenticated-cli-origin-only"
                }
              }
            },
            "dispatch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executionPath",
                "method",
                "path",
                "body",
                "attemptHeader",
                "attemptId",
                "workerAdmission",
                "redirects",
                "automaticRetry",
                "clientWaitMs",
                "requestContract",
                "maximumConcurrentCoordinators",
                "busyOutcome",
                "attemptMeaning",
                "profileDigestHeader",
                "contextContract",
                "contextSource",
                "concurrencyScope"
              ],
              "properties": {
                "executionPath": {
                  "const": "request"
                },
                "method": {
                  "const": "POST"
                },
                "path": {
                  "const": "/sfx/v1/hosted-execution/acceptance"
                },
                "body": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                },
                "attemptHeader": {
                  "const": "X-SFX-Acceptance-Attempt-Id"
                },
                "attemptId": {
                  "const": "client-generated-uuid"
                },
                "workerAdmission": {
                  "const": "forbidden"
                },
                "redirects": {
                  "const": "forbidden"
                },
                "automaticRetry": {
                  "const": false
                },
                "clientWaitMs": {
                  "const": 230000
                },
                "requestContract": {
                  "const": "hosted-execution-acceptance-request.v1"
                },
                "maximumConcurrentCoordinators": {
                  "const": 1
                },
                "busyOutcome": {
                  "const": "ACCEPTANCE_BUSY"
                },
                "attemptMeaning": {
                  "const": "correlation-not-idempotency"
                },
                "profileDigestHeader": {
                  "const": "X-SFX-Hosted-Profile-Digest"
                },
                "contextContract": {
                  "const": "hosted-execution-acceptance-context.v1"
                },
                "contextSource": {
                  "const": "host-ingress-not-request-body"
                },
                "concurrencyScope": {
                  "const": "host-deployment"
                }
              }
            },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "initiator",
                "probe",
                "provisioning",
                "refreshOwner",
                "passwordPrompt",
                "accountSwitch",
                "secretInInputOrEvidence",
                "fallbackPrincipal",
                "revokeSession"
              ],
              "properties": {
                "initiator": {
                  "const": "existing-operator-session"
                },
                "probe": {
                  "const": "existing-operator-session"
                },
                "provisioning": {
                  "const": "none"
                },
                "refreshOwner": {
                  "const": "existing-login"
                },
                "passwordPrompt": {
                  "const": false
                },
                "accountSwitch": {
                  "const": false
                },
                "secretInInputOrEvidence": {
                  "const": false
                },
                "fallbackPrincipal": {
                  "const": false
                },
                "revokeSession": {
                  "const": false
                }
              }
            },
            "failureContract": {
              "const": "hosted-execution-invocation-error.v1"
            },
            "uncertainOutcome": {
              "const": "retain-attempt-and-investigate-before-explicit-retry"
            },
            "completion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "proofContract",
                "evidence",
                "receiptRetention",
                "fulfilledOnlyWith",
                "consumerClientImplementationRequired",
                "verifierOwner",
                "deploymentChangesInvalidateProof",
                "publication"
              ],
              "properties": {
                "owner": {
                  "const": "host"
                },
                "proofContract": {
                  "const": "hosted-execution-delivery-proof.v1"
                },
                "evidence": {
                  "const": "live-supported-client-to-deployed-request-route"
                },
                "receiptRetention": {
                  "const": "host-recorded-before-response-and-returned-to-initiator"
                },
                "fulfilledOnlyWith": {
                  "const": "ACCEPTED-receipt-and-verified-delivery-proof"
                },
                "consumerClientImplementationRequired": {
                  "const": false
                },
                "verifierOwner": {
                  "const": "host-with-consumer-readback"
                },
                "deploymentChangesInvalidateProof": {
                  "const": true
                },
                "publication": {
                  "const": "profile-client-provider-bindings-and-schemas-as-one-verified-release"
                }
              }
            },
            "readback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "capabilityId",
                "surface",
                "executionPath",
                "method",
                "path",
                "inputContract",
                "resultContract",
                "authorization",
                "credentialRelease",
                "provider",
                "retention",
                "receiptBytesPointer",
                "encoding",
                "notFoundMeaning"
              ],
              "properties": {
                "owner": {
                  "const": "host"
                },
                "capabilityId": {
                  "const": "read-hosted-execution-acceptance"
                },
                "surface": {
                  "const": "capability observe"
                },
                "executionPath": {
                  "const": "request"
                },
                "method": {
                  "const": "GET"
                },
                "path": {
                  "const": "/sfx/v1/hosted-execution/acceptance/{attemptId}"
                },
                "inputContract": {
                  "const": "hosted-execution-acceptance-read-request.v1"
                },
                "resultContract": {
                  "const": "hosted-execution-acceptance-read-result.v1"
                },
                "authorization": {
                  "const": "same-pinned-operator-binding"
                },
                "credentialRelease": {
                  "const": false
                },
                "provider": {
                  "const": "sfx-api-host-acceptance-record-port.v1"
                },
                "retention": {
                  "const": "persistent-across-restarts-until-explicit-owner-retirement"
                },
                "receiptBytesPointer": {
                  "const": "/receiptBytesBase64"
                },
                "encoding": {
                  "const": "base64"
                },
                "notFoundMeaning": {
                  "const": "no-retained-evidence-not-proof-of-no-execution"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cpython": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "implementation",
        "version",
        "soabi",
        "platform",
        "wheelTags",
        "flags"
      ],
      "properties": {
        "kind": {
          "const": "cpython"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "implementation": {
          "const": "cpython"
        },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "type": "integer"
            },
            "minor": {
              "type": "integer"
            }
          }
        },
        "soabi": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "machine",
            "libc",
            "libcMinimumVersion"
          ],
          "properties": {
            "system": {
              "const": "Linux"
            },
            "machine": {
              "type": "string",
              "minLength": 1
            },
            "libc": {
              "const": "glibc"
            },
            "libcMinimumVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          }
        },
        "wheelTags": {
          "description": "Wheel tags this interpreter can load, as the packaging specification defines them.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "-I",
              "-S",
              "-B"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "gnuTimeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "identity",
        "exitWhenTerminated",
        "exitWhenKilled",
        "killAfterOption"
      ],
      "properties": {
        "kind": {
          "const": "gnu-timeout"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "identity": {
          "description": "What `timeout --version` prints first.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "versionLinePattern"
          ],
          "properties": {
            "package": {
              "const": "GNU coreutils"
            },
            "versionLinePattern": {
