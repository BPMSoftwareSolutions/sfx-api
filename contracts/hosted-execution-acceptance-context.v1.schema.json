{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attemptId",
    "expectedProfileDigest",
    "requestExecutionId",
    "executionPath",
    "caller",
    "request"
  ],
  "properties": {
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expectedProfileDigest": {
      "const": "sha256:0b5856fbe48aa9dba5783631e969d6628f681707b6bdcfa762fb058ca65d8f8d"
    },
    "requestExecutionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "executionPath": {
      "const": "request"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "principalId"
      ],
      "properties": {
        "kind": {
          "const": "user"
        },
        "principalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "body"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "path": {
          "const": "/sfx/v1/hosted-execution/acceptance"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosted-execution-acceptance-context.v1.schema.json",
  "description": "Internal capability input built by the host interface. Caller comes only from authenticated ingress; execution identity/path come from the actual host request; attempt and expected profile digest come from validated headers. This document is never accepted as a caller-supplied body. Schema-valid context still requires comparison with the operator binding before vault release."
}
