{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosted-execution-acceptance-read-result.v1.schema.json",
  "description": "Non-secret retained attempt lookup, authorized through ingress for the pinned operator. States carry no fake receipt. RECEIPT_AVAILABLE carries the exact original response bytes and their parsed value; the verifier reconciles all IDs, profile pins, byte counts and hashes. NOT_FOUND does not establish that an uncertain POST never executed. Restarts retain evidence and downgrade abandoned RUNNING attempts to UNKNOWN, never success.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "attemptId",
        "status"
      ],
      "properties": {
        "contractId": {
          "const": "hosted-execution-acceptance-read-result.v1"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "NOT_FOUND"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "attemptId",
        "status",
        "requestExecutionId",
        "profileDigest"
      ],
      "properties": {
        "contractId": {
          "const": "hosted-execution-acceptance-read-result.v1"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "RUNNING"
        },
        "requestExecutionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileDigest": {
          "const": "sha256:9760b6001d84576090a47a1ac02a4db5d728fdb1aea8cbef66b57376ff152f33"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "attemptId",
        "status",
        "requestExecutionId",
        "profileDigest"
      ],
      "properties": {
        "contractId": {
          "const": "hosted-execution-acceptance-read-result.v1"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "UNKNOWN"
        },
        "requestExecutionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileDigest": {
          "const": "sha256:9760b6001d84576090a47a1ac02a4db5d728fdb1aea8cbef66b57376ff152f33"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "attemptId",
        "status",
        "error"
      ],
      "properties": {
        "contractId": {
          "const": "hosted-execution-acceptance-read-result.v1"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "FAILED"
        },
        "error": {
          "allOf": [
            {
              "$ref": "hosted-execution-invocation-error.v1.schema.json"
            },
            {
              "properties": {
                "outcome": {
                  "const": "FAILED"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "attemptId",
        "status",
        "requestExecutionId",
        "profileDigest",
        "receiptSha256",
        "receiptByteLength",
        "receiptBytesBase64",
        "receipt"
      ],
      "properties": {
        "contractId": {
          "const": "hosted-execution-acceptance-read-result.v1"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "const": "RECEIPT_AVAILABLE"
        },
        "requestExecutionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileDigest": {
          "const": "sha256:9760b6001d84576090a47a1ac02a4db5d728fdb1aea8cbef66b57376ff152f33"
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "receiptByteLength": {
          "type": "integer",
          "minimum": 1
        },
        "receiptBytesBase64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "receipt": {
          "$ref": "hosted-execution-acceptance.v1.schema.json"
        }
      }
    }
  ]
}
