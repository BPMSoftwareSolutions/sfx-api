            "statement": "SET NOCOUNT ON; DECLARE @t TABLE(value nvarchar(max)); INSERT @t EXEC analysis.read_estate_execution_topology @input = N'{\"capabilityLimit\":1,\"relationshipLimit\":1}', @estate_model_pk = @estate_model_pk; DECLARE @topology nvarchar(max) = (SELECT TOP (1) value FROM @t); DECLARE @readable bit = CASE WHEN JSON_VALUE(@topology, '$.status') = N'READ' AND JSON_VALUE(@topology, '$.scope.read') = N'true' THEN 1 ELSE 0 END; SELECT (SELECT N'estate-scopes.v1' AS contractId, N'READ' AS status, JSON_VALUE(@input, '$.principalId') AS principalId, JSON_QUERY(CASE WHEN @readable = 1 THEN N'[' + JSON_MODIFY(JSON_MODIFY(JSON_QUERY(@topology, '$.estate'), '$.scopeId', JSON_VALUE(@topology, '$.scope.namespaceId')), '$.read', CONVERT(bit, 1)) + N']' ELSE N'[]' END) AS estates, JSON_QUERY(N'{\"available\":true,\"maximumIntervalMilliseconds\":86400000,\"reads\":{\"topology\":\"/sfx/v1/estate-execution/topology\",\"activity\":\"/sfx/v1/estate-execution/activity\",\"coverage\":\"/sfx/v1/estate-execution/coverage\",\"provenance\":\"/sfx/v1/estate-execution/provenance\",\"revision\":\"/sfx/v1/estate-execution/revision\"}}') AS retained, JSON_QUERY(N'{\"available\":true,\"stream\":\"/sfx/v1/estate-execution/stream\",\"resume\":[\"since\",\"Last-Event-ID\"],\"instanceHeader\":\"x-observer-instance\"}') AS live FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) AS value;",
