                    "statement": {
                      "op": "literal",
                      "value": "SET NOCOUNT ON; DECLARE @principal_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.principalId')); DECLARE @run_id varchar(128) = JSON_VALUE(@input, '$.runId'); DECLARE @session_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.sessionId')); DECLARE @expires datetimeoffset(7) = (SELECT s.expires_at FROM [identity].session s JOIN [identity].principal p ON p.principal_id = s.principal_id WHERE s.session_id = @session_id AND s.principal_id = @principal_id AND s.revoked_at IS NULL AND s.expires_at > SYSUTCDATETIME() AND p.active = 1); DECLARE @r TABLE(run_id varchar(128), capability_id nvarchar(512), namespace_id nvarchar(256), admitted_at datetime2(7), session_id uniqueidentifier, run_json nvarchar(max), graph_json nvarchar(max), output_json nvarchar(max), latest_cursor bigint, trace_complete bit, material_digest varbinary(32), graphs_json nvarchar(max), capture_status varchar(16)); IF @principal_id IS NOT NULL AND @run_id IS NOT NULL INSERT @r EXEC evidence.read_run @principal_id = @principal_id, @run_id = @run_id; SELECT (SELECT CASE WHEN EXISTS (SELECT 1 FROM @r) THEN 'READ' ELSE 'NOT_FOUND' END AS status, @run_id AS runId, (SELECT TOP (1) COALESCE(JSON_VALUE(run_json, '$.state'), 'admitted') FROM @r) AS state, TRY_CONVERT(bigint, JSON_VALUE(@input, '$.after')) AS after, JSON_VALUE(@input, '$.lastEventId') AS lastEventId, LOWER(CONVERT(varchar(36), @principal_id)) AS principalId, LOWER(CONVERT(varchar(36), @session_id)) AS sessionId, @expires AS sessionExpiresAt, CONVERT(bit, CASE WHEN @expires IS NULL THEN 0 ELSE 1 END) AS sessionLive, COALESCE(TRY_CONVERT(int, JSON_VALUE(@input, '$.recheckMilliseconds')), 5000) AS recheckMilliseconds FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES) AS value;"
                    },
                    "resultColumn": {
                      "op": "literal",
                      "value": "value"
                    },
                    "input": {
                      "op": "path",
                      "path": ""
                    }
                  }
                }
              }
            }
          }
