                      "op": "literal",
                      "value": "SET NOCOUNT ON; DECLARE @principal_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.principalId')); DECLARE @session_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.sessionId')); DECLARE @object nvarchar(64) = COALESCE(JSON_VALUE(@input, '$.admission.object'), N'capability'); DECLARE @operation nvarchar(64) = COALESCE(JSON_VALUE(@input, '$.admission.operation'), N'observe'); DECLARE @capability_id nvarchar(512) = JSON_VALUE(@input, '$.admission.subject'); DECLARE @namespace_id nvarchar(256) = COALESCE(JSON_VALUE(@input, '$.admission.namespace'), N'sidefx:capabilities'); DECLARE @header_key nvarchar(4000) = NULLIF(JSON_VALUE(@input, '$.idempotencyKey'), N''); DECLARE @body_key nvarchar(4000) = NULLIF(JSON_VALUE(@input, '$.admission.idempotencyKey'), N''); IF @header_key IS NOT NULL AND @body_key IS NOT NULL AND @header_key <> @body_key THROW 51000, 'IDEMPOTENCY_KEY_CONFLICT', 1; DECLARE @key nvarchar(4000) = COALESCE(@header_key, @body_key); IF @object <> N'capability' OR @operation NOT IN (N'observe', N'invoke') OR @capability_id IS NULL OR LEN(@capability_id) = 0 THROW 51000, 'ADMISSION_INVALID', 1; IF @capability_id IN (N'accept-hosted-execution-profile') THROW 51000, 'ADMISSION_REQUEST_PATH_ONLY', 1; IF @key IS NOT NULL AND (LEN(@key) = 0 OR LEN(@key) > 200) THROW 51000, 'IDEMPOTENCY_KEY_INVALID', 1; DECLARE @run_id varchar(128) = CASE WHEN @key IS NULL THEN LOWER(CONVERT(varchar(36), NEWID())) ELSE LOWER(CONVERT(varchar(36), CONVERT(uniqueidentifier, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(N'sfx-api-admission:', CONVERT(nvarchar(36), @principal_id), N':', @key)), 1, 16)))) END; DECLARE @before datetime2(7) = SYSUTCDATETIME(); DECLARE @r TABLE(run_id varchar(128), admitted_at datetime2(7)); BEGIN TRY INSERT @r EXEC evidence.register_run @run_id = @run_id, @principal_id = @principal_id, @session_id = @session_id, @capability_id = @capability_id, @namespace_id = @namespace_id, @writer_id = 'sfx-api'; END TRY BEGIN CATCH IF ERROR_MESSAGE() = 'EVIDENCE_CONFLICT' AND @key IS NOT NULL THROW 51000, 'IDEMPOTENCY_KEY_CONFLICT', 1; THROW; END CATCH; SELECT (SELECT r.run_id AS runId, CONVERT(datetimeoffset(7), r.admitted_at) AS admittedAt, CONVERT(bit, CASE WHEN r.admitted_at < @before THEN 1 ELSE 0 END) AS replayed, @operation AS operation, @namespace_id AS namespace, JSON_QUERY(@input, '$.admission') AS admission FROM @r r FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) AS value;"
