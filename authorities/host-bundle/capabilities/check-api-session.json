                      "op": "literal",
                      "value": "SET NOCOUNT ON; DECLARE @principal_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.principalId')); DECLARE @session_id uniqueidentifier = TRY_CONVERT(uniqueidentifier, JSON_VALUE(@input, '$.sessionId')); DECLARE @expires datetimeoffset(7) = (SELECT s.expires_at FROM [identity].session s JOIN [identity].principal p ON p.principal_id = s.principal_id WHERE s.session_id = @session_id AND s.principal_id = @principal_id AND s.revoked_at IS NULL AND s.expires_at > SYSUTCDATETIME() AND p.active = 1); SELECT (SELECT CASE WHEN @expires IS NULL THEN N'ENDED' ELSE N'LIVE' END AS status, @expires AS sessionExpiresAt FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES) AS value;"
